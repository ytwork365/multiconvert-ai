# MultiConvert AI - Environment Variables for Hostinger VPS
# Rename this file to .env before deploying

# Node.js environment
NODE_ENV=production

# Server port
PORT=3000

# Database connection
# Format: postgresql://username:password@hostname:port/database
DATABASE_URL=postgresql://dbuser:dbpassword@localhost:5432/multiconvertai

# OpenAI API key (required for image-to-text tool and other AI features)
OPENAI_API_KEY=your_openai_api_key

# Social media API keys (optional, only needed for specific tools)
# Instagram
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret

# Twitter
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret

# YouTube
YOUTUBE_API_KEY=your_youtube_api_key
