# Production Environment Variables
NODE_ENV=production

# PORT - Note: On Render, this will be set automatically to their internal port
# PORT=10000

# API Keys (Fill these with your actual API keys in Render's environment variables)
# VITE_INSTAGRAM_CLIENT_ID=your_instagram_client_id_here
# VITE_INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret_here
# VITE_TWITTER_API_KEY=your_twitter_api_key_here
# VITE_TWITTER_API_SECRET=your_twitter_api_secret_here
# VITE_YOUTUBE_API_KEY=your_youtube_api_key_here
# VITE_OPENAI_API_KEY=your_openai_api_key_here

# Session Secret (This will be set in Render's environment variables)
# SESSION_SECRET=change_this_to_a_secure_random_string

# Database connection (On Render, this will be set automatically via DATABASE_URL environment variable)
# DATABASE_URL=postgres://username:password@hostname:5432/database_name